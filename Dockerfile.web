FROM node:24-alpine AS livekit-sdk
WORKDIR /app/demo
COPY demo/package.json demo/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund

# This image only builds and serves the demo. The verification that used to live
# here — workspace tests, the adapter contracts, the WASM typechecks, and the
# Playwright compatibility gate — runs in Dagger: `dagger check` from the repo
# root for the workspace, and from `demo/` for the demo and the gate.
FROM rust:trixie AS frontend
ARG TARGETARCH
ARG DIOXUS_VERSION=0.7.9
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && rustup target add wasm32-unknown-unknown
RUN case "$TARGETARCH" in \
      amd64) DX_ARCH="x86_64-unknown-linux-gnu" ;; \
      arm64) DX_ARCH="aarch64-unknown-linux-gnu" ;; \
      *) echo "Unsupported build architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://github.com/DioxusLabs/dioxus/releases/download/v${DIOXUS_VERSION}/dx-${DX_ARCH}.tar.gz" -o /tmp/dx.tar.gz \
    && tar -xzf /tmp/dx.tar.gz -C /usr/local/bin \
    && rm /tmp/dx.tar.gz \
    && dx --version
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY docs/browser-compatibility.md ./docs/browser-compatibility.md
COPY demo ./demo
WORKDIR /app/demo
COPY --from=livekit-sdk /app/demo/node_modules/livekit-client/dist/livekit-client.umd.js ./public/livekit-client.umd.min.js
RUN dx bundle --fullstack true --web --release --debug-symbols=false --features raw-js-contract

FROM debian:trixie-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=frontend /app/demo/dist /app
ENV IP=0.0.0.0
ENV PORT=8080
EXPOSE 8080
WORKDIR /app
CMD ["./server"]
