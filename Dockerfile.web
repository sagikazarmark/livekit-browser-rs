FROM node:24-alpine AS livekit-sdk
WORKDIR /app/demo
COPY demo/package.json demo/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund

FROM node:24-alpine AS adapter-contracts
WORKDIR /app/crates/livekit-browser/js
COPY crates/livekit-browser/js/package.json crates/livekit-browser/js/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY crates/livekit-browser/js ./
COPY test-prototype.sh /app/test-prototype.sh
COPY tests/test-prototype.test.sh /app/tests/test-prototype.test.sh
COPY --from=livekit-sdk /app/demo/node_modules/livekit-client/dist/livekit-client.umd.js /app/livekit-client.umd.js
RUN sh /app/tests/test-prototype.test.sh \
    && LIVEKIT_CLIENT_UMD=/app/livekit-client.umd.js npm run check \
    && touch /adapter-contracts-passed

FROM rust:trixie AS frontend
ARG TARGETARCH
ARG DIOXUS_VERSION=0.7.9
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && rustup target add wasm32-unknown-unknown
RUN case "$TARGETARCH" in \
      amd64) DX_ARCH="x86_64-unknown-linux-gnu" ;; \
      arm64) DX_ARCH="aarch64-unknown-linux-gnu" ;; \
      *) echo "Unsupported build architecture: $TARGETARCH" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://github.com/DioxusLabs/dioxus/releases/download/v${DIOXUS_VERSION}/dx-${DX_ARCH}.tar.gz" -o /tmp/dx.tar.gz \
    && tar -xzf /tmp/dx.tar.gz -C /usr/local/bin \
    && rm /tmp/dx.tar.gz \
    && dx --version
WORKDIR /app
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY docs/browser-compatibility.md ./docs/browser-compatibility.md
COPY demo ./demo
COPY --from=adapter-contracts /adapter-contracts-passed /tmp/adapter-contracts-passed
RUN cargo test -p livekit-browser tests::adapter_contracts_are_fresh -- --exact \
    && cargo test -p livekit-browser --doc \
    && cargo test --workspace --all-features \
    && cargo check --workspace --all-features \
    && cargo check --workspace --all-features --target wasm32-unknown-unknown
WORKDIR /app/demo
COPY --from=livekit-sdk /app/demo/node_modules/livekit-client/dist/livekit-client.umd.js ./public/livekit-client.umd.min.js
# The demo is its own workspace, so its checks only resolve from this directory.
RUN cargo test --no-default-features --features token \
    && cargo check --features raw-js-contract --target wasm32-unknown-unknown \
    && cargo check --no-default-features --features worker --target wasm32-unknown-unknown
RUN dx bundle --fullstack true --web --release --debug-symbols=false --features raw-js-contract

FROM debian:trixie-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=frontend /app/demo/dist /app
ENV IP=0.0.0.0
ENV PORT=8080
EXPOSE 8080
WORKDIR /app
CMD ["./server"]
