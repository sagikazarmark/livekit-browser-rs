# Copy to .dev.vars for `npm run dev`, or pass to Dagger with
# `dagger call worker dev --env-file=.dev.vars up`, which mounts it as .dev.vars.
#
# Deployed, LIVEKIT_URL is a plain [vars] entry in wrangler.toml while the key
# and secret are set with `wrangler secret put`. Locally .dev.vars carries all
# three, because that is the only mechanism wrangler dev has for secrets.

# Signaling URL of the LiveKit Cloud project. Required: unlike the Docker stack
# there is no LiveKit server on the Worker's own origin to fall back to.
LIVEKIT_URL=wss://your-project.livekit.cloud

# Credentials the token endpoint signs with. These never reach the browser.
# The defaults below are LiveKit's public development pair, which only a local
# `livekit-server --dev` accepts; a Cloud project needs its own.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
