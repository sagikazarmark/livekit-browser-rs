type Demo {
  let node: NodeEnvironment!
  let dioxus: Dioxus!
  let workerDioxus: Dioxus!
  let workerBuild: WorkerBuild!
  let envFile: File

  new(rustVersion: String!, envFile: File) {
    let rustContainer = Dagger.container.from("rust:" + rustVersion)

    let cargoRegistryIndexCache = Dagger.cacheVolume("cargo-registry-index")
    let cargoRegistryArchiveCache = Dagger.cacheVolume("cargo-registry-cache")
    let cargoGitDbCache = Dagger.cacheVolume("cargo-git-db")

    # `dx` keys its bundle output on the crate name alone, so two concurrent
    # `dx bundle` runs of this crate share `target/dx/demo` and race: one wipes
    # the wasm the other's wasm-opt pass is about to read. `dagger check` runs
    # `build` and `worker:build` in parallel, so each gets its own target cache
    # rather than one shared volume. The registry and git caches are only ever
    # read concurrently, so those stay shared.
    self.node = Dagger.nodeEnvironment(install: true, locked: true)
    self.dioxus = Dagger.dioxus(
      container: rustContainer,
      envFile: envFile,
      cargoRegistryIndexCache: cargoRegistryIndexCache,
      cargoRegistryArchiveCache: cargoRegistryArchiveCache,
      cargoGitDbCache: cargoGitDbCache,
      cargoTargetCache: Dagger.cacheVolume("livekit-browser-rs-cargo-target-app"),
    )
    self.workerDioxus = Dagger.dioxus(
      container: rustContainer,
      envFile: envFile,
      cargoRegistryIndexCache: cargoRegistryIndexCache,
      cargoRegistryArchiveCache: cargoRegistryArchiveCache,
      cargoGitDbCache: cargoGitDbCache,
      cargoTargetCache: Dagger.cacheVolume("livekit-browser-rs-cargo-target-worker-client"),
    )
    self.workerBuild = Dagger.workerBuild(
      container: rustContainer,
      envFile: envFile,
      cargoRegistryIndexCache: cargoRegistryIndexCache,
      cargoRegistryArchiveCache: cargoRegistryArchiveCache,
      cargoGitDbCache: cargoGitDbCache,
      cargoTargetCache: Dagger.cacheVolume("livekit-browser-rs-cargo-target-worker"),
    )
    self.envFile = envFile

    self
  }

  """
  The pinned LiveKit browser SDK, taken from node_modules rather than a CDN.
  """
  livekitClient(ws: Workspace!): File! {
    self
      .node
      .container(ws)
      .file("node_modules/livekit-client/dist/livekit-client.umd.js")
  }

  """
  The crate's `public/` directory, with the browser SDK filled in.

  `dx` copies every file under `public/` verbatim into the served root, which is
  where `Dioxus.toml`'s `[web.resource]` entries expect to find them.
  """
  assets(ws: Workspace!): Directory! {
    Dagger
      .directory
      .withFile("public/styles.css", ws.file("public/styles.css"))
      .withFile("public/livekit-client.umd.min.js", self.livekitClient(ws))
  }

  let withAssets(ws: Workspace!): Workspace! {
    # DAGGER_TODO:
    # the browser SDK is normally ignored by git, so adding it back causes
    # it to be ignored next time workspace is called
    ws
      .withNewFile(
        ".gitignore",
        ws.file(".gitignore").contents + "\n" + ["!/public/livekit-client.umd.min.js"].join("\n"),
      )
      .withNewDirectory("public", self.assets(ws).directory("public"))
  }

  """
  Build the demo application as a full-stack bundle.
  """
  build(ws: Workspace!): Directory! @check {
    self
      .dioxus
      .bundle(
        self.withAssets(ws),
        fullstack: true,
        release: true,
        debugSymbols: false,
      )
  }

  """
  Serve the demo application.
  """
  service(ws: Workspace!): Service! @up {
    self.dioxus.serve(self.withAssets(ws), fullstack: true)
  }

  """
  Cloudflare Worker operations.
  """
  worker: Worker! {
    Worker(self)
  }
}

type Worker {
  let parent: Demo!

  """
  Builds the Cloudflare Worker bundle.

  The client is a plain SPA rather than a full-stack build: on Workers the only
  server-side route is the token endpoint, which `src/worker.rs` serves.
  """
  build(ws: Workspace!): Directory! @check {
    let client = parent
      .workerDioxus
      .bundle(
        parent.withAssets(ws),
        fullstack: false,
        release: true,
        debugSymbols: false,
        platform: DioxusPlatform.WEB,
      )

    let server = parent
      .workerBuild
      .build(ws, args: ["--no-default-features", "--features", "worker"])

    Dagger
      .directory
      .withDirectory("dist", client)
      .withDirectory("dist/worker", server)
      .withFile("wrangler.toml", ws.file("wrangler.toml"))
  }

  """
  Runs the Cloudflare Worker locally using `wrangler dev`.
  """
  dev(ws: Workspace!): Service! {
    Dagger.wrangler.dev(build(ws)
      .{
        if (parent.envFile != null) {
          _.withFile(".dev.vars", parent.envFile!)
        } else _
      })
  }

  """
  Deploys the Cloudflare Worker.
  """
  deploy(
    ws: Workspace!,
    """
    Account ID for the Cloudflare account.
    """
    accountId: String!,
    """
    API token for the Cloudflare account.
    """
    apiToken: Secret!,
  ): Void @cache(policy: FunctionCachePolicy.Never) {
    Dagger
      .wrangler(accountId: accountId, apiToken: apiToken)
      .deploy(build(ws))
      .sync

    null
  }

  """
  Uploads a preview version of the Worker for a pull request.
  """
  deployPullRequest(
    ws: Workspace!,
    """
    Pull request number.
    """
    pullRequest: Int!,
    """
    Commit hash the preview is built from.
    """
    commit: String!,
    """
    Account ID for the Cloudflare account.
    """
    accountId: String!,
    """
    API token for the Cloudflare account.
    """
    apiToken: Secret!,
    """
    GitHub token used to comment the preview URLs on the pull request.
    """
    githubToken: Secret!,
    """
    GitHub repository the pull request belongs to.
    """
    repository: String!,
  ): String! @cache(policy: FunctionCachePolicy.Never) {
    let shortSha = commit.truncate(7)
    let alias = `pr-${toString(pullRequest)}`

    let upload = Dagger
      .wrangler(accountId: accountId, apiToken: apiToken)
      .versions
      .upload(
        build(ws),
        tag: shortSha,
        message: `Preview for PR #${toString(pullRequest)} (${shortSha})`,
        previewAlias: alias,
      )

    let body = [
      "### ☁️ Cloudflare Workers preview",
      "",
      "| Deployment | URL |",
      "| --- | --- |",
      "| Commit (`" + shortSha + "`) | " + (upload.previewUrl ?? "n/a") + " |",
      "| Pull request (`" + alias + "`) | " + (upload.previewAliasUrl ?? "n/a") + " |",
    ].join("\n")

    let comment = Dagger
      .container
      .from("alpine:3.24.1@sha256:28bd5fe8b56d1bd048e5babf5b10710ebe0bae67db86916198a6eec434943f8b")
      .withExec(["apk", "add", "--no-cache", "github-cli"])
      .withSecretVariable("GH_TOKEN", githubToken)
      .withExec(
        [
          "gh", "pr", "comment", toString(pullRequest),
          "--repo", repository,
          "--body", body,
          "--edit-last", "--create-if-none",
        ],
        expect: ReturnType.ANY,
      )

    if (comment.exitCode != 0) {
      print("Failed to comment the preview URLs on the pull request: " + comment.stderr)
    }

    JSON.encode(upload)
  }
}
