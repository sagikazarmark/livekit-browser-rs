(prototype_app) {
	encode zstd gzip
	header Permissions-Policy "camera=(self), microphone=(self), display-capture=(self)"

	handle /rtc* {
		reverse_proxy livekit:7880
	}

	handle {
		reverse_proxy app:8080
	}
}

http://:8080 {
	import prototype_app
}

https://{$LAN_HOST}:8443 {
	tls internal
	import prototype_app
}
